# Banco de dados
DB_PATH=data/placar.db
# Base de jogadores (CV8): durável, nunca apagada pelo reset do banco das quadras.
GERENCIADOR_DB_PATH=data/gerenciador.db
# Backup do gerenciador.db (CV8.TS1). Vazio = desligado. No compose a pasta do
# host ./backups é montada em /backups (chown 1001:1001 uma vez).
GERENCIADOR_BACKUP_DIR=
GERENCIADOR_BACKUP_INTERVALO_HORAS=6
GERENCIADOR_BACKUP_MANTER=28

# Segredo do Owner (autenticação do operador da instância)
# Obrigatorio no docker compose; o app recusa o valor de exemplo em producao.
OWNER_SECRET=troque-este-segredo-em-producao

# Timeout de ausência do admin antes de sucessão automática (em segundos)
ADMIN_TIMEOUT_SECONDS=120

# Porta e host do servidor
HOST=0.0.0.0
PORT=8000

# Janela de presenca efetiva para o limite de participantes (em segundos)
PRESENCA_TTL_SECONDS=120

# Apelidos (qualquer caixa, separados por virgula) que habilitam o relogio.
# Sao gravados em Title: eli -> Eli. Vazio exige scripts/watch_access.py.
WATCH_AUTO_GRANT=eli

# Atras do Cloudflare Tunnel: limites de tentativa usam CF-Connecting-IP.
# Desligue se a porta for exposta sem o tunel (o header poderia ser forjado).
TRUST_CLOUDFLARE=true
# Cookie de sessao so por HTTPS. Desligue apenas para acesso por http na LAN.
COOKIE_SECURE=true

# Banco de dados
DB_PATH=data/placar.db

# Segredo do Owner (autenticação do operador da instância)
OWNER_SECRET=troque-este-segredo-em-producao

# Timeout de ausência do admin antes de sucessão automática (em segundos)
ADMIN_TIMEOUT_SECONDS=120

# Porta e host do servidor
HOST=0.0.0.0
PORT=8000

# Janela de presenca efetiva para o limite de participantes (em segundos)
PRESENCA_TTL_SECONDS=120
